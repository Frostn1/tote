  ],
  "homepage": "https://github.com/Frostn1/amazon-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frostn1/amazon-mcp.git"
  },
  "bugs": "https://github.com/Frostn1/amazon-mcp/issues",
  "license": "MIT",
  "type": "module",
  "bin": {
